rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Marketing sample apps: anyone opening a sample link may read the lead.
    // All other platform writes stay on /api/proxy (service account).
    match /leads/{leadId} {
      allow read: if true;
    }
    // First sign-in flow: the couple signs in with the emailed temporary
    // password, the app reads their own admins doc to show the
    // set-permanent-password screen, and saving the new password flips
    // mustSetPassword in place.
    //
    // Couple apps also run their admin panel against this collection
    // (invites for photographers/vendors, removals, the team list), gated on
    // the caller having their own admins doc.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    match /admins/{email} {
      allow read: if request.auth != null
        && (request.auth.token.email == email || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Couple app content (the anniversary portal) ──────────────────────
    // Shared content is publicly readable. Guests are anonymous sign-ins;
    // admins hold an admins doc with their email as the doc id.

    match /posts/{postId} {
      allow read: if true;
      // Guests share memories that stay pending until an admin approves.
      allow create: if request.auth != null
        && (request.resource.data.pending == true || isAdmin());
      // Admins approve, edit and clear reports; guests may only bump the
      // comment count on a post they just commented on.
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['commentCount']));
      allow delete: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if isAdmin();
      }
      match /reactions/{uid} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /residents/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Soft-deleted posts, visible to admins only (auto-purge after 3 days).
    match /deleted_posts/{postId} {
      allow read, write: if isAdmin();
    }

    // App configuration: guests read the access code and event details,
    // admins write.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
